@{
}
@model CollegeStudentManagement.Models.Login
<html>
    <head>
        <style>
            .loginb{
                position:absolute;
                top:30%;
                left:50%;
                transform:translate(-50%);
                padding:20px;
                background-color:#fff8e7;
                border:2px solid black;
                border-radius:10px;
                width:330px;
                height:270px;

            }
            body{
                background-color:lightblue;
                margin:0;
                display:flex;
                justify-content:center;
                align-items:center;
                height:100vh;
            }
            input{
                width:100%;
                height:35px;
                margin-top:5px;
                margin-bottom:10px;
            }
            button{
            width: 100%;
            height: 40px;
            background-color:green;
            color:white;
            border:none;
            border-radius:5px;
            font-size:18px;
            cursor:pointer;
            }
           .msg{
               position:fixed;
               bottom:15px;
               left:50%;
               transform:translateX(-50%);
               color:red;
               font-size:15px;
              
           }

        </style>
    </head>
    <body>
        <form asp-action="Login" method="post">
        <div class="loginb">
       user name:<br />
       <input type="text" asp-for="Username" autocomplete="off"/><br />
       password:<br />
       <input type="password" asp-for="Password" /><br />
       <button type="submit">submit</button>
    </div>
    </form>
    @if(ViewBag.Message != null)
    {
        <h3 class="msg">@ViewBag.Message</h3>
    }
</body>

</html>