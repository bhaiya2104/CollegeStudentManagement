@{
}
@model CollegeStudentManagement.Models.Student

@{
    ViewData["Title"] = "Student Details";
}
<html>
<head>
    <style>
        body{
            background-color:#EAF6FF;
        }
        .main{
            height:100%;
            width:500px;
            border:2px solid black;
            padding-left:10px;
           


        }
    </style>
</head>
<body>
<h1>Student Details</h1>
<div class="main">
<p><strong>Student ID:</strong> @Model.StudentId</p>
<p><strong>Name:</strong> @Model.Name</p>
<p><strong>Email:</strong> @Model.Email</p>
<p><strong>Mobile:</strong> @Model.Mobile</p>
<p><strong>Gender:</strong> @Model.Gender</p>
<p><strong>Course:</strong> @Model.Course</p>
<p><strong>Year:</strong> @Model.Year</p>
<p><strong>Address:</strong> @Model.Address</p>

<br />
</div>
<a asp-action="Index">Back to Student List</a>
</body>
</html>